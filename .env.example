# Copy this file to .env only when you need to override a default.
MIR_ENVIRONMENT=development
MIR_DEBUG=false
MIR_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
MIR_DATABASE_ECHO=false
MIR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MIR_EMBEDDING_DEVICE=cpu
MIR_EMBEDDING_BATCH_SIZE=32
MIR_VECTOR_COLLECTION_NAME=mir_chunks
MIR_OLLAMA_BASE_URL=http://127.0.0.1:11434
MIR_OLLAMA_MODEL=qwen3:8b
MIR_LLM_PROVIDER=ollama
MIR_GEMINI_API_KEY=
MIR_GEMINI_MODEL=gemini-2.5-flash
MIR_MAX_UPLOAD_SIZE_MB=25
MIR_CHUNK_SIZE=500
MIR_CHUNK_OVERLAP=75
MIR_RAG_MIN_RETRIEVAL_SCORE=0.30
MIR_RAG_MAX_SENTENCES_PER_CITATION_GROUP=2
MIR_RAG_LEXICAL_COVERAGE_MIN=0.60
MIR_RAG_LEXICAL_IDF_COVERAGE_MIN=0.40
MIR_BM25_FINETUNED_K1=1.5
MIR_BM25_FINETUNED_B=0.75
