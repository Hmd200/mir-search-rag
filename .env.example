# Copy this file to .env only when you need to override a default.
MIR_ENVIRONMENT=development
MIR_DEBUG=false
MIR_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MIR_DATABASE_ECHO=false
MIR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MIR_EMBEDDING_DEVICE=cpu
MIR_EMBEDDING_BATCH_SIZE=32
MIR_VECTOR_COLLECTION_NAME=mir_chunks
MIR_OLLAMA_BASE_URL=http://127.0.0.1:11434
MIR_OLLAMA_MODEL=qwen3:8b
MIR_MAX_UPLOAD_SIZE_MB=25
MIR_CHUNK_SIZE=500
MIR_CHUNK_OVERLAP=75
